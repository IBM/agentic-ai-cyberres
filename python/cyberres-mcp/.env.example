# Environment configuration for MCP recovery validation prototype

# Host interface to bind the MCP server.
# Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only when you explicitly need the server reachable from
# other hosts and have network-level access controls in place.
MCP_HOST=127.0.0.1

# Port for the MCP server. Defaults to 8000
MCP_PORT=8000

# Transport used by FastMCP. Defaults to streamable-http
MCP_TRANSPORT=streamable-http

# Path to a JSON file containing secrets (unused in prototype)
SECRETS_FILE=secrets.json